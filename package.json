{
  "name": "campcount",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
