{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level is PRODUCTION, so Cloudflare Workers Builds (which runs a plain
  // `wrangler deploy`) deploys production. Local development uses env.dev
  // (CLOUDFLARE_ENV=dev, set by `npm run dev`).
  "name": "campcount",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "EMAIL_FROM": "CampCount <no-reply@campcount.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campcount-production",
      "database_id": "482b526e-b957-4f62-ae3b-d6b67d198c5b",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] },
  // Cloudflare Email Service binding for sign-in codes (enable sending for the domain first).
  "send_email": [{ "name": "EMAIL" }],
  // AUTH_SECRET is a secret: set it in the dashboard (Settings, Variables and Secrets)
  // or with `npx wrangler secret put AUTH_SECRET`.
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "development",
        "EMAIL_FROM": "CampCount Dev <no-reply@campcount.com>"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "campcount-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
      "triggers": { "crons": [] }
    }
  }
}
